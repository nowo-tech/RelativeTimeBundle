{% extends 'base.html.twig' %}

{% block title %}Relative Time Bundle - Demo - {{ version_badge }}{% endblock %}

{% block body %}
    <h1>Relative Time Bundle – Demo</h1>
    <p><span class="nowo-ui-badge nowo-ui-badge--neutral">{{ version_badge }}</span></p>
    <p>Reference now: <code>{{ now|date('Y-m-d H:i:s') }}</code></p>

    <section class="nowo-ui-card">
        <div class="nowo-ui-card__header"><h2 class="nowo-ui-card__title">Service + Twig filter (multi-locale)</h2></div>
        <div class="nowo-ui-card__body">
        <table class="nowo-ui-data-table">
            <thead>
                <tr>
                    <th>Case</th>
                    <th>ISO</th>
                    <th>en</th>
                    <th>es</th>
                    <th>fr</th>
                    <th>de</th>
                    <th>Twig |relative_time</th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                <tr>
                    <td>{{ row.label }}</td>
                    <td><code>{{ row.iso }}</code></td>
                    <td>{{ row.en }}</td>
                    <td>{{ row.es }}</td>
                    <td>{{ row.fr }}</td>
                    <td>{{ row.de }}</td>
                    <td>{{ row.iso|relative_time(null, now) }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
    </section>

    <section class="nowo-ui-card">
        <div class="nowo-ui-card__header"><h2 class="nowo-ui-card__title">Twig helpers</h2></div>
        <div class="nowo-ui-card__body">
        <p><code>ago</code> filter: {{ rows[2].iso|ago(null, now) }}</p>
        <p><code>relative_time()</code> function (es): {{ relative_time(rows[2].iso, 'es', now) }}</p>
        </div>
    </section>
{% endblock %}
